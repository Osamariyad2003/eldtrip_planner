fly.toml
.git/

# Secrets. .env holds the real provider key; COPY . /code would bake it into an
# image layer, where anyone who can pull the image can read it. Provider keys
# are Fly secrets instead (FR-SYS-02, NFR-SEC-02).
.env
.env.*

# The local virtualenv is ~250 MB of Windows binaries that would not run in the
# image anyway; it installs its own from requirements.txt.
.venv/

# Local database and caches, all regenerated.
*.sqlite3
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.ruff_cache/
staticfiles/
